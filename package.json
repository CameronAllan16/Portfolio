    "babel-plugin-macros": "^3.1.0",
    "patch-package": "^8.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^6.10.0"
  },
  "scripts": {
    "dev": "vite",
